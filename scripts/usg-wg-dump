#!/usr/bin/python
import subprocess, sys
if len(sys.argv) != 1:
    sys.exit(2)
data = subprocess.check_output(['/usr/bin/wg', 'show', 'all', 'dump'])
for line in data.splitlines():
    fields = line.split('\t')
    if len(fields) == 5:
        fields[1] = '(hidden)'
    elif len(fields) == 9:
        fields[2] = '(hidden)'
    else:
        continue
    print('\t'.join(fields))
