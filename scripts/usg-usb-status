#!/usr/bin/python
import glob, json, os, re, subprocess, sys
if len(sys.argv) != 1:
    sys.exit(2)
def read(path):
    try:
        return open(path).read().strip()
    except IOError:
        return ''
devices = []
mounts = [line.split() for line in open('/proc/mounts')]
for path in sorted(glob.glob('/sys/block/sd*')):
    name = os.path.basename(path)
    if not re.match(r'^sd[a-z]+$', name) or '/usb' not in os.path.realpath(path):
        continue
    disk = {'device': '/dev/' + name, 'model': read(path + '/device/model'),
            'bytes': int(read(path + '/size') or '0') * 512, 'partitions': []}
    for part in sorted(glob.glob(path + '/' + name + '[0-9]*')):
        dev = '/dev/' + os.path.basename(part)
        p = subprocess.Popen(['/sbin/blkid', '-c', '/dev/null', '-o', 'export', dev], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, err = p.communicate()
        info = dict(line.split('=', 1) for line in out.splitlines() if '=' in line)
        disk['partitions'].append({'device': dev, 'label': info.get('LABEL', ''),
            'filesystem': info.get('TYPE', 'unknown'),
            'mounted': any(row[0] == dev for row in mounts),
            'mountpoints': [row[1] for row in mounts if row[0] == dev]})
    devices.append(disk)
mounted = any(row[1] == '/srv/usg-files' for row in mounts)
try:
    usage = os.statvfs('/srv/usg-files') if mounted else None
except OSError:
    usage = None
total = usage.f_blocks * usage.f_frsize if usage else None
used = (usage.f_blocks - usage.f_bfree) * usage.f_frsize if usage else None
print(json.dumps({'devices': devices, 'automatic_mounting': 'Configured USB files UUID only',
    'file_sharing_configured': True, 'protocol': 'SFTP', 'path': '/srv/usg-files',
    'mounted': mounted, 'total_bytes': total, 'used_bytes': used,
    'used_percent': 100.0 * used / total if total else None,
    'available_bytes': usage.f_bavail * usage.f_frsize if usage else None}))
